opam-version: "2.0"
synopsis: "Native OCaml implementation for DataScript OCaml"
description: "Native OCaml implementation package for the DataScript OCaml virtual library."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1.1"}
  "dune" {>= "3.17"}
  "datascript_ocaml" {= version}
  "persistent_sorted_set_ocaml" {= "dev"}
  "sqlite3"
  "melange-transit-native" {= "0.1.1"}
  "yojson"
]
pin-depends: [
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#main"]
  ["melange-edn-core.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#main"]
  ["melange-edn-native.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#main"]
  ["melange-transit-core.0.1.1" "git+https://github.com/RCmerci/melange-transit.git#main"]
  ["melange-transit-native.0.1.1" "git+https://github.com/RCmerci/melange-transit.git#main"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
