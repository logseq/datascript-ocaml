(rule
 (alias bench)
 (deps
  bench_ocaml.exe
  bench_ocaml_js.bc.js
  memory_ocaml.exe
  memory_ocaml_js.bc.js
  bench_upstream.js
  memory_upstream.js
  ../script/benchmark_vs_cljs.sh)
 (action
  (setenv
   BENCH_SKIP_BUILD
   1
   (run bash %{dep:../script/benchmark_vs_cljs.sh}))))

(rule
 (alias runtest)
 (deps
  bench_ocaml.exe
  bench_output_test.sh)
 (action
  (run bash %{dep:bench_output_test.sh} %{dep:bench_ocaml.exe})))

(rule
 (alias runtest)
 (deps
  ../script/benchmark_gate_vs_cljs_check.js
  ../script/benchmark_gate_vs_cljs_check_test.sh)
 (action
  (run bash %{dep:../script/benchmark_gate_vs_cljs_check_test.sh})))
