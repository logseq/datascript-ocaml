(executable
 (name index_compare_20k)
 (modules index_compare_20k)
 (libraries datascript-ocaml-native unix))

;; Shared scenario code depends on the virtual datascript library; each
;; executable selects a concrete implementation (native vs jsoo).
(library
 (name memory_bench_common)
 (modules memory_scenario)
 (libraries datascript))

(executable
 (name bench_ocaml)
 (modules bench_ocaml)
 (modes exe)
 (libraries datascript-ocaml-native unix))

;; js_of_ocaml bench must use the jsoo package (native LMDB is not linkable to JS).
(executable
 (name bench_ocaml_js)
 (modules bench_ocaml_js)
 (modes js)
 (libraries datascript-ocaml-jsoo js_of_ocaml))

(executable
 (name query_profile)
 (modules query_profile)
 (modes exe)
 (libraries datascript-ocaml-native unix))

(executable
