opam-version: "2.0"
synopsis: "js_of_ocaml implementation for DataScript OCaml"
description: "js_of_ocaml implementation package for the DataScript OCaml virtual library."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2.1"}
  "dune" {>= "3.17"}
  "datascript_ocaml" {= version}
  "persistent_sorted_set_ocaml" {= "dev"}
  "persistent_sorted_set_ocaml-native" {= "dev"}
  "js_of_ocaml"
]
pin-depends: [
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#9b4e736dfe429861efff7d5c388451a2ad6152f7"]
  ["persistent_sorted_set_ocaml-native.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#9b4e736dfe429861efff7d5c388451a2ad6152f7"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
