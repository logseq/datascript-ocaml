opam-version: "2.0"
synopsis: "SQLite persistent storage for DataScript OCaml"
description: "File-backed SQLite storage sessions for datascript-ocaml-native."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1.1"}
  "dune" {>= "3.17"}
  "datascript-ocaml-native" {= version}
  "sqlite3"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
