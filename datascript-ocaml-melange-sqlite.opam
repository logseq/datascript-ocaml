opam-version: "2.0"
synopsis: "SQLite persistent storage for DataScript OCaml (Melange)"
description:
  "SQLite storage sessions for datascript-ocaml-melange. The host injects a synchronous SQLite driver (sqlite-wasm, node:sqlite, ...); this package does not pick a runtime."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1.1"}
  "dune" {>= "3.17"}
  "datascript-ocaml-melange" {= version}
  "melange"
]
build: [
  ["dune" "build" "-p" "datascript_ocaml,datascript-ocaml-melange,datascript-ocaml-melange-sqlite" "-j" jobs]
]
