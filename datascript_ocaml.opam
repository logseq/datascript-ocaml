opam-version: "2.0"
synopsis: "An OCaml 5 rewrite of DataScript"
description: "A OCaml 5 rewrite of DataScript."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.2.1"}
  "dune" {>= "3.17"}
  "persistent_sorted_set_ocaml" {= "dev"}
  "melange"
]
pin-depends: [
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#9b4e736dfe429861efff7d5c388451a2ad6152f7"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
