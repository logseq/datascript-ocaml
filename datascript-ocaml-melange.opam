opam-version: "2.0"
synopsis: "Melange implementation for DataScript OCaml"
description: "Melange implementation package for the DataScript OCaml virtual library."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1.1"}
  "dune" {>= "3.17"}
  "datascript_ocaml" {= version}
  "melange"
  "melange-transit-melange" {= "0.1.1"}
]
pin-depends: [
  ["melange-edn-core.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#main"]
  ["melange-edn-melange.0.5.0" "git+https://github.com/RCmerci/melange-edn.git#main"]
  ["melange-transit-core.0.1.1" "git+https://github.com/RCmerci/melange-transit.git#main"]
  ["melange-transit-melange.0.1.1" "git+https://github.com/RCmerci/melange-transit.git#main"]
]
build: [
  # Virtual `datascript` lives in datascript_ocaml. Building the Melange
  # implementer alone (-p name) looks for byte cmis that only exist when the
  # virtual library is in the same dune -p set.
  ["dune" "build" "-p" "datascript_ocaml,datascript-ocaml-melange" "-j" jobs]
]
