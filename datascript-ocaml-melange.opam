opam-version: "2.0"
synopsis: "Melange implementation for DataScript OCaml"
description: "Melange implementation package for the DataScript OCaml virtual library."
maintainer: "rcmerci"
authors: ["rcmerci"]
license: "MIT"
depends: [
  "ocaml" {>= "5.1.1"}
  "dune" {>= "3.17"}
  "datascript_ocaml" {= version}
  "persistent_sorted_set_ocaml" {= "dev"}
  "melange"
  "melange-transit-melange" {= "0.1.2"}
]
pin-depends: [
  ["persistent_sorted_set_ocaml.dev" "git+https://github.com/logseq/persistent-sorted-set-ocaml.git#b4c97e37b4d62175b376d76e795c298071444343"]
  ["melange-edn-core.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-edn-melange.0.5.0" "git+https://github.com/logseq/melange-edn.git#main"]
  ["melange-transit-core.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
  ["melange-transit-melange.0.1.2" "git+https://github.com/logseq/melange-transit.git#main"]
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
